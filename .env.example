# AI ProjectDNA Environment Configuration

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aiprojectdna
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aiprojectdna
POSTGRES_PORT=5432

# Backend Settings
BACKEND_PORT=8000
FALLBACK_TO_SQLITE=True
JWT_SECRET_KEY=ai-projectdna-secure-jwt-secret-key-phase2-prod-ready-32bytes-min
COOKIE_SECURE=False

# Google Gemini AI Integration (Phase 3)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Research Paper Discovery Integration (Phase 4.1)
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=
RESEARCH_SEARCH_MAX_RESULTS=20
RESEARCH_PROVIDER_TIMEOUT=20

# GitHub Repository Discovery Integration (Phase 4.2)
GITHUB_TOKEN=
GITHUB_API_TIMEOUT=20
GITHUB_SEARCH_MAX_RESULTS=30
GITHUB_MAX_QUERIES=5

# GitHub Deep Analysis & Innovation Gap Detection (Phase 4.3)
GITHUB_ANALYSIS_MAX_REPOS=10
GITHUB_README_MAX_CHARS=25000
GITHUB_ANALYSIS_TIMEOUT=30

# Semantic Embedding & Cross-Source Similarity Engine (Phase 4.4)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
SIMILARITY_HIGH_THRESHOLD=0.70
SIMILARITY_MODERATE_THRESHOLD=0.50

# RAG Research Gap Validation Engine (Phase 4.5)
RAG_MAX_PAPERS=15
RAG_MAX_REPOS=15
RAG_MAX_GAPS=20
RAG_CONTEXT_MAX_CHARS=40000
RAG_EVIDENCE_MIN_SIMILARITY=0.20

# Patent & Prior-Art Discovery Engine (Phase 4.6)
USPTO_API_KEY=
USPTO_API_URL=https://api.patentsview.org/patents/query
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
PATENT_SEARCH_MAX_RESULTS=20
PATENT_PROVIDER_TIMEOUT=25
RAG_MAX_PATENTS=10

# Frontend Settings
VITE_API_URL=http://localhost:8000/api
FRONTEND_PORT=5173
